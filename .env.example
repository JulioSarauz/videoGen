# --- Servidor ---
PORT=3100
NODE_ENV=production

# --- Autenticacion (password compartida + JWT) ---
# Hash bcrypt de la contrasena compartida. Generalo con:
#   node server/scripts/hash-password.js "tu-password"
AUTH_PASSWORD_HASH=
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
COOKIE_SECURE=true

# --- Proveedor de video activo: OpenRouter (Kling/Veo/Minimax/Seedance/Wan/Sora) ---
# API Key generada en openrouter.ai/settings/keys. Factura por saldo con
# auto-recarga de tarjeta.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo de texto (no video) usado para sugerir variantes de prompt.
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# --- Limites y validacion de imagen ---
MAX_UPLOAD_MB=15
MIN_LONG_EDGE_PX=1080

# --- Chequeo de fidelidad post-generacion ---
FIDELITY_MAX_DIFF=0.18

# --- Modulo de audio: Gemini (transcripcion) ---
# API Key generada en aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cuota diaria gratis observada para este modelo (ajustar si Google la cambia).
GEMINI_DAILY_QUOTA=20
MAX_AUDIO_MB=50

# --- Modulo de audio: Pollinations (generacion de imagenes, sin key) ---
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
