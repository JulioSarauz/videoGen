# --- Servidor ---
PORT=3100
NODE_ENV=production

# --- Autenticacion (password compartida + JWT) ---
# Hash bcrypt de la contrasena compartida. Generalo con:
#   node server/scripts/hash-password.js "tu-password"
AUTH_PASSWORD_HASH=
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
COOKIE_SECURE=true

# --- Proveedor de video: Kling AI ---
# API Key unica generada en kling.ai/dev/api-key (metodo recomendado, bearer token).
# El "Name" que le pusiste a la key en el dashboard es solo una etiqueta, no va aqui.
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com
# Verifica estos paths contra la documentacion vigente de Kling antes de producir:
KLING_IMAGE2VIDEO_PATH=/v1/videos/image2video
KLING_IMAGE2VIDEO_STATUS_PATH=/v1/videos/image2video

# --- Limites y validacion de imagen ---
MAX_UPLOAD_MB=15
MIN_LONG_EDGE_PX=1080

# --- Chequeo de fidelidad post-generacion ---
FIDELITY_MAX_DIFF=0.18

# --- Modulo de audio: Gemini (transcripcion) ---
# API Key generada en aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_AUDIO_MB=50

# --- Modulo de audio: Pollinations (generacion de imagenes, sin key) ---
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
